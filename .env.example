# Nothing in this repo reads a .env file. Export these in your shell, or copy this to
# .env and load it yourself: `set -a; source .env; set +a`. The SDK also picks up an
# `ant auth login` profile, in which case no key is needed at all.

ANTHROPIC_API_KEY=sk-ant-...

# Override the model. Defaults to claude-opus-5.
# PAPERPARSE_ANTHROPIC_MODEL=claude-sonnet-5

# Textract backend. Standard AWS credential resolution applies (env vars, a shared
# profile, or an instance role) — the IAM principal needs textract:AnalyzeDocument.
# AWS_REGION=us-east-1
# AWS_PROFILE=default
