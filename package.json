{
  "name": "paperparse",
  "version": "0.1.0",
  "description": "Extract structured data from photographs of handwritten paper forms, with a reproducible eval harness.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "bench": "tsx scripts/bench.ts",
    "extract": "tsx scripts/extract-one.ts",
    "record": "tsx scripts/record-run.ts",
    "ui": "tsx ui/server.ts",
    "review": "tsx scripts/apply-review.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/client-textract": "^3.1161.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
